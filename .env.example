# HTTP server
PORT=8080

# Postgres connection (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=rss_aggregator
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Background scraper
SCRAPER_ENABLED=false
SCRAPER_CONCURRENCY=3
SCRAPER_INTERVAL=10m

# Redis: optional. With REDIS_ENABLED=false, or an unreachable Redis, the API
# behaves exactly as it did without it — nothing cached, nothing rate limited.
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# How long a cached read response stays valid. The scraper invalidates it
# early whenever it stores new items.
CACHE_TTL=60s

# Requests allowed per API key per window (needs Redis)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
